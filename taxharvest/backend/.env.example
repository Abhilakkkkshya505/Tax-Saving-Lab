# Copy this file to .env and fill in your own values for local development.
# Never commit your actual .env file.

# Database connection. Defaults to local SQLite if unset.
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/taxharvest
DATABASE_URL=sqlite:///./taxharvest.db

# Secret key used to sign JWT auth tokens. Generate a strong random value
# for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string
